# Copy to .env for local development (`npm run dev`), and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# These are server-only: they are used by /api/contact and never sent to the browser.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Sender address. Must be on a domain you've verified in Resend
# (https://resend.com/domains), e.g. "Projection Academy <hello@projectionacademy.in>".
# Leave unset to use Resend's test sender (onboarding@resend.dev): enquiries then only
# reach the email you signed up to Resend with, and no confirmation goes to the student.
RESEND_FROM_EMAIL=

# Inbox that receives website enquiries (defaults to academyprojection@gmail.com)
CONTACT_TO_EMAIL=academyprojection@gmail.com
